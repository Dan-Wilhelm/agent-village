<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd job: runs the vault sync every 5 minutes.
  1. Replace the two REPLACE_ME paths below.
  2. cp this file to ~/Library/LaunchAgents/com.agentvillage.vault-sync.plist
  3. launchctl load ~/Library/LaunchAgents/com.agentvillage.vault-sync.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentvillage.vault-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>REPLACE_ME/agent-village/scripts/vault-sync.sh</string>
    <string>REPLACE_ME/path/to/your/vault/Agent Village</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/agent-village-vault-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/agent-village-vault-sync.log</string>
</dict>
</plist>
