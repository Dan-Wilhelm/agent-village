# Agent Village — environment variables
# Copy to .env.local and fill in YOUR OWN values. Never commit real values.

# --- Login (Better Auth: Google + passkeys, owner only) ---
# Random secret, 32+ chars: openssl rand -base64 32 (use a different one per environment)
BETTER_AUTH_SECRET=
# Public URL of this app, e.g. https://village.example.com (http://localhost:3100 in development)
BETTER_AUTH_URL=
# Google OAuth client (Google Cloud Console → Credentials → OAuth client ID, type "Web application").
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Owner lock ---
# The ONE email address allowed to use this instance (your Google account's email).
OWNER_EMAIL=

# --- Database (Neon Postgres) ---
DATABASE_URL=

# --- Encryption of stored integration tokens ---
# 32 random bytes, base64. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Claude API (added in Phase 3) ---
ANTHROPIC_API_KEY=

# Optional: pin the owner's user id as a second check (shown in the server log / DB after first sign-in).
OWNER_USER_ID=



# Development only (never set in Vercel): enables /api/dev/login for automated browser tests
DEV_LOGIN_SECRET=

# --- Agent knowledge vault (private GitHub repo synced into Obsidian) ---
# owner/repo, e.g. you/brain-agents
VAULT_REPO=
# Fine-grained token with Contents read/write on VAULT_REPO ONLY
GITHUB_VAULT_TOKEN=

# --- Calendar feed (Apps Script web app, see docs/integrations/google-calendar-feed.gs) ---
CALENDAR_FEED_URL=
CALENDAR_FEED_SECRET=
